# Copy this file to .env (git-ignored) and replace the placeholder.
#
# Generate a key, Git Bash:
#   echo "fbx_admin_$(openssl rand -base64 32 | tr '+/' '-_' | tr -d '=\n' | cut -c1-43)"
# Generate a key, PowerShell:
#   "fbx_admin_" + (-join ((48..57 + 65..90 + 97..122) | Get-Random -Count 43 | ForEach-Object { [char]$_ }))
#
# The key must start with fbx_admin_ and be at least 40 characters.
# It is registered once, on the first start, and then ignored.
FLAGBOX_BOOTSTRAP_ADMIN_KEY=fbx_admin_REPLACE_WITH_A_GENERATED_KEY
