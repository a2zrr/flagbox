root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.{java,xml,yml,yaml,properties}]
indent_size = 4

[*.{yml,yaml,json,md}]
indent_size = 2

[*.sql]
indent_size = 4

[*.cmd]
end_of_line = crlf

[*.md]
trim_trailing_whitespace = false
